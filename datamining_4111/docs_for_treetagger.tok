included
lower
birth
weight
(
p
<
0
.
001
)
,
lower
gestational
age
(
p
<
0
.
001
)
,
positive
SARS-CoV-2
PCR
results
(
OR
=
15
.
333
;
95
%
CI
=
2
.
074-113
.
381
,
p
=
0
.
007
)
,
asphyxia
(
OR
=
13
.
143
;
95
%
CI
=
1
.
411-122
.
443
,
p
=
0
.
024
)
,
and
mortality
(
OR
=
156
.
000
;
95
%
CI
=
13
.
157-1849
.
623
;
p
<
0
.
001
)
.
Mortality
was
significantly
associated
with
lower
gestational
age
(
p
=
0
.
025
)
,
cesarean
section
delivery
(
p
=
0
.
025
)
,
and
