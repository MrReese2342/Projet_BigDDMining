depression
(
PHQ-9
score
>
=
10
)
and
clinical
anxiety
(
GAD-7
score
>
=
7
)
(
clinical
depression
:
OR
,
1
.
31
;
95
%
CI
,
1
.
04-1
.
66
;
P
=
0
.
025
;
clinical
anxiety
:
OR
,
1
.
36
;
95
%
CI
,
1
.
07-1
.
72
;
P
=
